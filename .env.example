# Supabase — same project as the Hype web app.
# Use the SERVICE ROLE key (server-side only), never the anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anthropic — used only as a fallback when structured data (JSON-LD)
# is missing a field. Same key the web app uses.
ANTHROPIC_API_KEY=sk-ant-...

# ScraperAPI — used ONLY to fetch pages behind a Cloudflare JS challenge
# (Passline's LISTING host). Detail pages are fetched directly. Get a free key
# at https://www.scraperapi.com/ (free tier covers a couple runs/day). Without
# it, Passline discovery will be blocked (403); detail parsing still works.
SCRAPERAPI_KEY=

# Optional. "1" / "true" = parse and log everything but write NOTHING to
# Supabase or storage. Great for a first run. Default: off.
DRY_RUN=0

# Optional. Comma-separated source names to run. Default: all registered.
# e.g. SOURCES=passline
SOURCES=
